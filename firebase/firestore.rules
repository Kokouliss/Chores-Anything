rules_version = '2';

// Who may read and write what. The document layout is described in
// core/data/src/main/kotlin/com/kokouliss/choresanything/core/data/firebase/FirestoreSchema.kt.
// Change both together, and run `npm test` in this folder before deploying.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Email invitations only count for an address the sign-in provider has verified.
    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isInvited(household) {
      return request.auth.token.email_verified == true && myEmail() in household.invitedEmails;
    }

    function household(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)).data;
    }

    function isHouseholdMember(householdId) {
      return signedIn() && uid() in household(householdId).memberIds;
    }

    // An adult adds chores that go through at once, confirms what kids ask for and changes any
    // chore. A member entry without a role is an adult: everyone joins as one, the owner demotes.
    function isAdult(householdId) {
      return household(householdId).members[uid()].get('role', 'adult') == 'adult';
    }

    // True when, after this write, the invite document for `code` points at this household.
    function inviteWillPointHere(householdId, code) {
      return getAfter(/databases/$(database)/documents/invites/$(code)).data.householdId == householdId;
    }

    function validHousehold(household) {
      return household.keys().hasOnly(['name', 'ownerId', 'memberIds', 'members', 'inviteCode', 'invitedEmails', 'createdAt'])
        && household.name is string && household.name.size() > 0 && household.name.size() <= 60
        && household.ownerId is string
        && household.memberIds is list
        && household.members is map
        // Same alphabet as InviteCode in the app: no 0, 1, I or O.
        && household.inviteCode is string && household.inviteCode.matches('^[A-HJ-NP-Z2-9]{8}$')
        && household.invitedEmails is list;
    }

    function validMemberEntry(entry) {
      return entry.name is string && entry.name.size() > 0 && entry.name.size() <= 100
        && entry.get('role', 'adult') in ['adult', 'kid'];
    }

    function validHandoff(handoff) {
      return handoff.keys().hasOnly(['toId', 'toName', 'byId', 'byName'])
        && handoff.toId is string
        && handoff.toName is string && handoff.toName.size() <= 100
        && handoff.byId is string
        && handoff.byName is string && handoff.byName.size() <= 100;
    }

    // The limits match the MAX_ constants in core/domain/.../model/Chore.kt.
    function validChore(chore) {
      return chore.keys().hasOnly(['title', 'info', 'needs', 'minutes', 'assigneeId', 'assigneeName', 'rotation', 'dueDay',
          'dueMinute', 'repeat', 'remindBefore', 'status', 'createdById', 'createdByName', 'createdAt', 'doneAt', 'doneById',
          'doneByName', 'handoff'])
        && chore.title is string && chore.title.size() > 0 && chore.title.size() <= 80
        && chore.info is string && chore.info.size() <= 1000
        && chore.needs is list && chore.needs.size() <= 20
        && (!('minutes' in chore) || (chore.minutes is int && chore.minutes >= 1 && chore.minutes <= 1440))
        && (!('assigneeId' in chore) || chore.assigneeId is string)
        && (!('assigneeName' in chore) || (chore.assigneeName is string && chore.assigneeName.size() <= 100))
        && chore.rotation is list && chore.rotation.size() <= 50
        // Days since 1 January 1970, and minutes after midnight on that day.
        && (!('dueDay' in chore) || chore.dueDay is int)
        && (!('dueMinute' in chore) || (chore.dueMinute is int && chore.dueMinute >= 0 && chore.dueMinute < 1440))
        && (!('repeat' in chore) || chore.repeat in ['day', 'week', 'twoWeeks', 'month'])
        // Minutes before the due time the reminder rings, at most a week.
        && (!('remindBefore' in chore) || (chore.remindBefore is int && chore.remindBefore >= 0 && chore.remindBefore <= 10080))
        && chore.status in ['pending', 'open']
        && chore.createdById is string
        && chore.createdByName is string && chore.createdByName.size() <= 100
        && chore.createdAt is timestamp
        && (!('doneAt' in chore) || chore.doneAt is timestamp)
        && (!('doneById' in chore) || chore.doneById is string)
        && (!('doneByName' in chore) || (chore.doneByName is string && chore.doneByName.size() <= 100))
        && (!('handoff' in chore) || validHandoff(chore.handoff));
    }

    // One line of a household's history, in its writer's own name, at the time the server reads it.
    // Firestore deletes it at expireAt (the TTL policy in firestore.indexes.json); a day over the
    // app's 365 allows for a phone whose clock is off.
    function validActivity(entry) {
      return entry.keys().hasOnly(['kind', 'byId', 'byName', 'choreId', 'choreTitle', 'forId', 'forName', 'minutes', 'at', 'expireAt'])
        && entry.kind in ['added', 'asked', 'confirmed', 'declined', 'changed', 'deleted', 'done', 'undone', 'passed', 'took', 'refused']
        && entry.byId == uid()
        && entry.byName is string && entry.byName.size() <= 100
        && entry.choreId is string && entry.choreId.size() <= 100
        && entry.choreTitle is string && entry.choreTitle.size() <= 80
        && (!('forId' in entry) || entry.forId is string)
        && (!('forName' in entry) || (entry.forName is string && entry.forName.size() <= 100))
        && (!('minutes' in entry) || (entry.minutes is int && entry.minutes >= 0 && entry.minutes <= 1440))
        && entry.at == request.time
        && entry.expireAt is timestamp && entry.expireAt <= request.time + duration.value(366, 'd');
    }

    match /households/{householdId} {
      // Members see their households. Invited people see the household so they can accept or decline.
      allow read: if signedIn() && (uid() in resource.data.memberIds || isInvited(resource.data));

      // A new household has exactly one member, its owner, and comes with its invite document.
      allow create: if signedIn()
        && validHousehold(request.resource.data)
        && request.resource.data.ownerId == uid()
        && request.resource.data.memberIds == [uid()]
        && request.resource.data.members.keys().hasOnly([uid()])
        && validMemberEntry(request.resource.data.members[uid()])
        && request.resource.data.invitedEmails.size() == 0
        && inviteWillPointHere(householdId, request.resource.data.inviteCode);

      allow update: if signedIn()
        && validHousehold(request.resource.data)
        && (ownerEdits() || memberEditsEmailInvites() || joinsWithCode()
            || acceptsEmailInvite() || declinesEmailInvite() || leaves() || handsOver() || renamesSelf());

      allow delete: if signedIn() && resource.data.ownerId == uid();

      function changedFields() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function changedMembers() {
        return request.resource.data.members.diff(resource.data.members).affectedKeys();
      }

      // The owner may rename the household, remove members, make them adults or kids, manage email
      // invites and replace the invite code, but never hand the household to someone else, lock
      // themselves out or make themselves a kid.
      function ownerEdits() {
        return resource.data.ownerId == uid()
          && changedFields().hasOnly(['name', 'inviteCode', 'memberIds', 'members', 'invitedEmails'])
          && uid() in request.resource.data.memberIds
          && request.resource.data.members[uid()].get('role', 'adult') == 'adult'
          && (request.resource.data.inviteCode == resource.data.inviteCode
              || inviteWillPointHere(householdId, request.resource.data.inviteCode));
      }

      function memberEditsEmailInvites() {
        return uid() in resource.data.memberIds && changedFields().hasOnly(['invitedEmails']);
      }

      // The only change is that the caller appears as a new member.
      function addsOnlySelf() {
        return !(uid() in resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && uid() in request.resource.data.memberIds
          && changedMembers().hasOnly([uid()])
          && validMemberEntry(request.resource.data.members[uid()]);
      }

      // Someone who cannot read the household proves they know its code by writing it into their own
      // member entry. A wrong guess is simply rejected.
      function joinsWithCode() {
        return changedFields().hasOnly(['memberIds', 'members'])
          && addsOnlySelf()
          && request.resource.data.members[uid()].inviteCode == resource.data.inviteCode;
      }

      function removesOnlyOwnEmailInvite() {
        return request.resource.data.invitedEmails.toSet()
          == resource.data.invitedEmails.toSet().difference([myEmail()].toSet());
      }

      function acceptsEmailInvite() {
        return isInvited(resource.data)
          && changedFields().hasOnly(['memberIds', 'members', 'invitedEmails'])
          && addsOnlySelf()
          && removesOnlyOwnEmailInvite();
      }

      function declinesEmailInvite() {
        return isInvited(resource.data)
          && changedFields().hasOnly(['invitedEmails'])
          && removesOnlyOwnEmailInvite();
      }

      // The caller disappears from memberIds and members, and no other member changes.
      function removesOnlySelf() {
        return uid() in resource.data.memberIds
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          && !(uid() in request.resource.data.memberIds)
          && changedMembers().hasOnly([uid()])
          && !(uid() in request.resource.data.members);
      }

      // A member removes themselves and nothing else. The owner hands over or deletes the household instead.
      function leaves() {
        return uid() != resource.data.ownerId
          && changedFields().hasOnly(['memberIds', 'members'])
          && removesOnlySelf();
      }

      // A member changes the name in their own entry, and nothing else: not their role.
      function renamesSelf() {
        return uid() in resource.data.memberIds
          && changedFields().hasOnly(['members'])
          && changedMembers().hasOnly([uid()])
          && request.resource.data.members[uid()].diff(resource.data.members[uid()]).affectedKeys().hasOnly(['name'])
          && validMemberEntry(request.resource.data.members[uid()]);
      }

      // The owner leaves and makes another member the owner, so the household goes on without them.
      function handsOver() {
        return uid() == resource.data.ownerId
          && changedFields().hasOnly(['ownerId', 'memberIds', 'members'])
          && request.resource.data.ownerId in resource.data.memberIds
          && request.resource.data.ownerId != uid()
          && removesOnlySelf();
      }

      match /chores/{choreId} {
        allow read: if isHouseholdMember(householdId);

        // A chore is added in one's own name, now. An adult's goes through; a kid's waits for an adult.
        allow create: if isHouseholdMember(householdId)
          && validChore(request.resource.data)
          && request.resource.data.createdById == uid()
          && request.resource.data.createdAt == request.time
          && !request.resource.data.keys().hasAny(['doneAt', 'doneById', 'doneByName', 'handoff'])
          && request.resource.data.status == (isAdult(householdId) ? 'open' : 'pending');

        allow update: if isHouseholdMember(householdId)
          && validChore(request.resource.data)
          && !changedChore().hasAny(['createdById', 'createdByName', 'createdAt'])
          && passesInOwnName()
          && (isAdult(householdId) || kidEdits());

        // An adult deletes any chore (declining a kid's is deleting it); a kid only their own waiting one.
        allow delete: if isHouseholdMember(householdId)
          && (isAdult(householdId) || (resource.data.status == 'pending' && resource.data.createdById == uid()));

        function changedChore() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }

        // A hand-over that appears or changes carries the caller as the one who passes it on.
        function passesInOwnName() {
          return !('handoff' in changedChore())
            || !('handoff' in request.resource.data)
            || request.resource.data.handoff.byId == uid();
        }

        // A kid changes what their own waiting chore is; otherwise they do, undo, take, pass on or
        // hand back a chore they are part of, and never what a chore is or whether it is confirmed.
        function kidEdits() {
          return (resource.data.status == 'pending'
              && resource.data.createdById == uid()
              && request.resource.data.status == 'pending')
            || (resource.data.status == 'open'
              && !changedChore().hasAny(['title', 'info', 'needs', 'minutes', 'rotation', 'repeat', 'remindBefore', 'dueMinute', 'status'])
              && involved());
        }

        // The chore is theirs or anyone's, they just did or undid it, or it was passed to them.
        function involved() {
          return resource.data.get('assigneeId', uid()) == uid()
            || request.resource.data.get('doneById', '') == uid()
            || resource.data.get('doneById', '') == uid()
            || resource.data.get('handoff', {}).get('toId', '') == uid();
        }
      }

      // Who added, did, passed on or confirmed what: the household's history. Written once and never
      // changed; it goes by itself at expireAt, or with the household.
      match /activity/{entryId} {
        allow read: if isHouseholdMember(householdId);
        allow create: if isHouseholdMember(householdId) && validActivity(request.resource.data);
        allow update, delete: if false;
      }
    }

    // The devices that get a person's notifications. Only that person's own devices write here;
    // firebase/functions reads it with admin rights.
    match /users/{userId}/tokens/{token} {
      allow read, delete: if signedIn() && uid() == userId;
      allow create, update: if signedIn() && uid() == userId
        && request.resource.data.keys().hasOnly(['updatedAt']);
    }

    // invites/{code} maps an invite code to its household.
    match /invites/{code} {
      // Fetched by exact code only, so codes cannot be listed.
      allow get: if signedIn();
      allow list: if false;

      // Only together with a household, owned by the caller, that uses exactly this code.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['householdId'])
        && getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.ownerId == uid()
        && getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.inviteCode == code;

      allow update: if false;

      allow delete: if signedIn()
        && get(/databases/$(database)/documents/households/$(resource.data.householdId)).data.ownerId == uid();
    }
  }
}
